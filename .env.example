# ─────────────────────────────────────────────────────────
# FORGE-Vision Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://forgevision:yourpassword@localhost:5432/forgevision

# ── Security ──────────────────────────────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SETTINGS_ENCRYPTION_KEY=your-fernet-key-here

# JWT signing (RS256 — generate an RSA key pair and paste here)
# For dev only you can use a simple secret; for production use RS256 key pair
JWT_SECRET_KEY=dev-secret-change-in-production

# ── Application ───────────────────────────────────────────
ENVIRONMENT=development          # development | production
ALLOWED_HOSTS=localhost,127.0.0.1
API_BASE_URL=http://localhost:8000

# ── Default LLM (overridden by database settings once configured) ──
LLM_PROVIDER=groq                # openai | groq | anthropic | gemini | ollama
LLM_MODEL=llama-3.1-8b-instant
# Leave blank — API keys are entered via the Settings page and stored encrypted in DB
# OPENAI_API_KEY=
# GROQ_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
