# ─────────────────────────────────────────────────────────
# FORGE-Vision — PRODUCTION environment (self-hosted Docker stack)
# Copy to .env.production and fill in REAL values. NEVER commit the filled file.
#
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build
# ─────────────────────────────────────────────────────────

# ── Domain + TLS ──────────────────────────────────────────
# Point this domain's DNS A/AAAA record at the host BEFORE first boot —
# Caddy needs it to obtain a Let's Encrypt certificate (HTTP-01 on port 80/443).
DOMAIN=forge.example.com
ACME_EMAIL=you@example.com

# ── Database (bundled Postgres container) ─────────────────
POSTGRES_USER=forgevision
POSTGRES_PASSWORD=CHANGE_ME_strong_random_password
POSTGRES_DB=forgevision
# Optional: to use an EXTERNAL managed DB instead of the bundled container,
# set DATABASE_URL here (and you may remove the `db` service from the compose).
#   e.g. Supabase pooler:
# DATABASE_URL=postgresql+asyncpg://postgres.<ref>:<pwd>@aws-0-<region>.pooler.supabase.com:5432/postgres?ssl=require&prepared_statement_cache_size=0

# ── Security (REQUIRED — app refuses to boot on dev defaults) ──
# Fernet key:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SETTINGS_ENCRYPTION_KEY=CHANGE_ME_fernet_key
# Long random secret:  openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_ME_long_random_secret

# ── Application ───────────────────────────────────────────
# ALLOWED_HOSTS defaults to DOMAIN; set explicitly if you serve multiple hosts.
ALLOWED_HOSTS=forge.example.com
# 1 = seed synthetic simulation data on first boot (only if tables are empty).
# Set to 0 after the first successful boot.
SEED_ON_START=1

# ── Default LLM (the API key is entered in the in-app Settings page, ──
# ── stored encrypted in the DB — do NOT put provider keys here) ──────
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
